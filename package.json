{
  "name": "devma-cake-n-party",
  "version": "1.0.0",
  "private": true,
  "description": "Devma Cake n' Party Management System — React storefront + Express API + MySQL, deployable to Vercel",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "setup": "node scripts/setup.js",
    "db:reset": "node scripts/setup.js --reset",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "npm test -w server",
    "db:setup": "npm run setup -w server"
  }
}
