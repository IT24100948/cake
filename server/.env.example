# ---------------------------------------------------------------------------
# Local development (Homebrew MySQL). On Vercel, set these under
# Project Settings -> Environment Variables instead (never commit .env).
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL - either a single URL (managed hosts give you this)...
# DATABASE_URL=mysql://user:password@host:4000/devma_cake_party
# DB_SSL=true
# ...or individual settings:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=devma_cake_party
DB_NAME_TEST=devma_test

# Business timezone (Sri Lanka). DB_TIMEZONE is the matching MySQL offset.
APP_TIMEZONE=Asia/Colombo
DB_TIMEZONE=+05:30

# Auth - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Uploads - leave empty locally (disk). On Vercel, connecting a Blob store sets this automatically.
BLOB_READ_WRITE_TOKEN=
